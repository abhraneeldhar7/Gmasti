---
import MarkdownRender from "@/components/ui/markdown-render/markdown-render";
import AppLayout from "@/layouts/AppLayout.astro";
import openSourceGuide from "@/content/openSourceGuide.md?raw";
---

<AppLayout title="Open Sourced">
    <div class="relative pb-20 min-h-screen">
        <div class="mx-auto max-w-[700px] pt-20 px-5">
            <a
                href="/"
                class="text-sm w-fit text-muted-foreground hover:text-foreground flex items-center gap-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
                Home
            </a>
            <h1 class="font-[Instrument] text-[50px] text-center mt-10">
                Is Gmasti Safe?
            </h1>
            <div class="mt-10">
                <MarkdownRender content={openSourceGuide} />
            </div>
        </div>
    </div>
</AppLayout>
