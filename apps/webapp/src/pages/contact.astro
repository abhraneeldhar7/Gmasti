---
import meImg from "@/assets/me.jpeg";
import AppLayout from "@/layouts/AppLayout.astro";

const getAge = () => {
    const today = new Date();
    const birthDate = new Date("2005-03-18");

    let age = today.getFullYear() - birthDate.getFullYear();
    const monthDiff = today.getMonth() - birthDate.getMonth();

    if (
        monthDiff < 0 ||
        (monthDiff === 0 && today.getDate() < birthDate.getDate())
    ) {
        age--;
    }

    return age;
};
---

<AppLayout title="Contact">
    <main
        class="h-[100svh] px-4 flex flex-col items-center justify-center"
        aria-label="Contact"
    >
        <section
            class="flex flex-col gap-7 text-[17px] text-muted-foreground max-w-[500px] w-full mx-auto justify-center"
            aria-labelledby="contact-title"
        >
            <div class="h-10">
                <a
                    href="/"
                    class="text-sm w-fit text-muted-foreground hover:text-foreground flex items-center gap-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                    Home
                </a>
            </div>
            <div class="flex items-end gap-3 justify-between w-full">
                <p class="shrink-0">
                    Hello, I am <a
                        href="https://x.com/veryNeel"
                        target="_blank"
                        class="text-foreground text-[20px] underline"
                        >Abhraneel <span class="hidden md:inline">Dhar</span></a
                    >
                </p>
                <div class="flex justify-center w-full px-2">
                    <img
                        src={meImg.src}
                        class="aspect-square object-cover max-w-[240px] w-full"
                    />
                </div>
            </div>
            <p>
                {getAge()}, Design Engineer. I expertise in controlling what the
                user feels when they use my products.
            </p>
            <p>
                Reach me at <a
                    href="mailto:abhraneeldhar@gmail.com"
                    class="underline text-foreground">abhraneeldhar@gmail.com</a
                >
            </p>
        </section>
    </main>
</AppLayout>
