---
import LegalDocument from "@/components/legal-document.astro";
import AppLayout from "@/layouts/AppLayout.astro";

const termsOfServiceProps = {
    title: "Terms of Service",
    summary:
        "These Terms of Service govern your use of the X Post Rewriter browser extension, operated by an independent developer. By installing or using the extension, you agree to these terms.",
    effectiveDate: "May 9, 2026",
    sections: [
        {
            title: "Acceptance of Terms",
            content:
                "By installing or using the X Post Rewriter extension, you agree to be bound by these Terms of Service. If you do not agree, please uninstall the extension and discontinue use.\n\nThis extension is operated by an independent developer based in Kolkata, India. These terms are governed by the laws of India, including the Information Technology Act, 2000 and applicable rules thereunder.",
        },
        {
            title: "What X Post Rewriter Is",
            content:
                "X Post Rewriter is a browser extension that rewrites the visible text of posts on X (formerly Twitter) in novelty language styles using AI. It provides:\n\n- A selection of rewrite styles including Caveman, Queen's English, Pirate, Shakespearean, and Gen Z\n- AI-powered text rewriting using a third-party language model API\n- Local caching of rewritten posts to reduce redundant processing\n- A usage dashboard showing your daily generation count\n\nThe extension only modifies how content appears in your browser. It does not alter, publish, or interact with posts on X in any way. It is a purely cosmetic, client-side tool.",
        },
        {
            title: "User Accounts and Authentication",
            content:
                "Access to the extension requires signing in with a Google account. By signing in, you authorize us to store your Google account email address and a unique identifier in our database solely for the purpose of managing your account and enforcing usage limits.\n\nYou are responsible for maintaining the security of your account. We are not liable for any unauthorized access resulting from actions on your part.",
        },
        {
            title: "Usage Limits",
            content:
                "Each account is permitted a maximum of 100 AI text generations per calendar day. This limit resets at midnight UTC.\n\nUsage limits exist to ensure fair access for all users and to manage operational costs. We reserve the right to adjust these limits at any time with reasonable notice.\n\nAttempting to circumvent usage limits through account manipulation, automated tooling, or any other means is a violation of these terms and may result in account suspension.",
        },
        {
            title: "Acceptable Use",
            content:
                "You agree to use the extension only for personal, non-commercial browsing. You may not:\n\n- Use the extension to process content in bulk through automated means\n- Attempt to reverse-engineer, tamper with, or extract API credentials from the extension or its backend\n- Use the extension in any way that violates X's Terms of Service or applicable law\n- Resell, sublicense, or otherwise commercialize access to the extension or its underlying API",
        },
        {
            title: "Third-Party Services",
            content:
                "This extension relies on third-party services to function, including a large language model API for text rewriting and Google OAuth for authentication. Your use of this extension is subject to the terms and privacy policies of those services.\n\nWe are not responsible for the availability, accuracy, or behavior of any third-party service. If a third-party service is unavailable, the extension's rewriting functionality will not work during that period.",
        },
        {
            title: "Content and AI Output",
            content:
                "The rewritten text produced by this extension is generated by an AI language model. We make no guarantees about the accuracy, appropriateness, or quality of AI-generated output.\n\nWe do not store the content of posts you submit for rewriting beyond the time required to process them. Rewritten text is cached locally in your browser and is not retained on our servers.\n\nYou acknowledge that AI-generated content may occasionally be nonsensical, inconsistent, or unexpected. This is a cosmetic entertainment tool and should not be relied upon for any serious purpose.",
        },
        {
            title: "Intellectual Property",
            content:
                "The original text of posts on X belongs to their respective authors. This extension does not claim any ownership over source content or AI-generated rewrites.\n\nThe extension software itself, including its design and backend infrastructure, is the property of the developer. You may not copy, redistribute, or create derivative works from it without explicit written permission.",
        },
        {
            title: "Disclaimers and Limitation of Liability",
            content:
                "The extension is provided as-is by an independent developer without warranties of any kind, express or implied.\n\nTo the maximum extent permitted by applicable law, the developer shall not be liable for any indirect, incidental, or consequential damages arising from your use of the extension, including but not limited to loss of data, service interruptions, or reliance on AI-generated output.\n\nThis is a hobby project maintained by a solo developer. Uptime, continued availability, and feature stability are not guaranteed.",
        },
        {
            title: "Termination",
            content:
                "We reserve the right to suspend or terminate your access to the extension at any time, with or without notice, if we reasonably believe you have violated these terms.\n\nYou may stop using the extension at any time by uninstalling it from your browser. Upon uninstallation, locally cached data stored by the extension will be cleared by your browser.",
        },
        {
            title: "Changes to These Terms",
            content:
                "We may update these Terms of Service from time to time. The effective date at the top of this page will reflect the most recent revision. Continued use of the extension after changes are posted constitutes your acceptance of the updated terms.\n\nFor significant changes, we will make reasonable efforts to notify users through the extension interface.",
        },
        {
            title: "Contact",
            content:
                "For questions, concerns, or abuse reports related to these terms, please reach out via the contact information listed on whitepapper.antk.in.",
        },
    ],
};
---

<AppLayout title="Terms of Service">
    <LegalDocument
        title={termsOfServiceProps.title}
        summary={termsOfServiceProps.summary}
        effectiveDate={termsOfServiceProps.effectiveDate}
        sections={termsOfServiceProps.sections}
    />
</AppLayout>
