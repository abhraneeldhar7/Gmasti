---
import LegalDocument from "@/components/legal-document.astro";
import AppLayout from "@/layouts/AppLayout.astro";

const privacyPolicyProps = {
    title: "Privacy Policy",
    summary:
        "This Privacy Policy explains what information the X Post Rewriter extension collects, how it is used, and how it is protected. We collect the minimum data necessary to provide the service and do not sell or share your data with third parties for advertising purposes.",
    effectiveDate: "May 9, 2026",
    sections: [
        {
            title: "Who We Are",
            content:
                "X Post Rewriter is a browser extension operated by an independent developer based in Kolkata, India. References to 'we', 'our', or 'us' in this policy refer to that individual developer.\n\nThis policy is governed by the laws of India, including the Information Technology Act, 2000, and the Digital Personal Data Protection Act, 2023.",
        },
        {
            title: "What Data We Collect",
            content:
                "We collect and store the following information:\n\n- Your Google account email address and Google-issued unique identifier, collected at the time of sign-in\n- A daily usage count tracking how many AI generations you have consumed on a given calendar date\n- The date your account was created\n\nWe do not collect your name, profile picture, phone number, location, or any other personal information beyond what is listed above.",
        },
        {
            title: "What We Do Not Collect",
            content:
                "We explicitly do not collect or store:\n\n- The text of posts you submit for rewriting. Post content is sent to the AI API for processing and is not retained on our servers after a response is returned.\n- Your browsing history or activity on X beyond what is necessary to process a rewrite request\n- The rewritten text generated by the AI. Rewritten content is cached locally in your browser only, not on our servers.\n- Any information about posts you viewed but did not submit for rewriting\n- Device identifiers, IP addresses logged beyond standard server infrastructure logs, or fingerprinting data",
        },
        {
            title: "How We Use Your Data",
            content:
                "The data we collect is used exclusively for the following purposes:\n\n- Identifying your account when you make a rewrite request\n- Enforcing the daily usage limit of 100 generations per account\n- Detecting and preventing abuse such as limit circumvention or unauthorized access\n\nWe do not use your data for advertising, profiling, analytics, or any purpose beyond operating the extension.",
        },
        {
            title: "Third-Party Services",
            content:
                "The extension relies on the following third-party services, each of which has its own privacy policy:\n\n- Google OAuth: used for authentication. When you sign in, Google shares your email and unique identifier with us under their OAuth consent flow. Google's privacy policy applies to that interaction.\n- Groq API: the text of posts you submit for rewriting is sent to Groq's API for processing. We do not control how Groq handles data on their end. You should review Groq's privacy policy before using the extension.\n\nWe do not sell, rent, or share your personal data with any third party for commercial purposes.",
        },
        {
            title: "Local Storage and Caching",
            content:
                "The extension stores the following data locally in your browser using Chrome's storage API:\n\n- Your authentication token, used to identify you on subsequent requests without requiring repeated sign-ins\n- Rewritten versions of posts, cached by post ID and selected style to avoid redundant API calls\n\nThis data lives entirely on your device. We have no access to it. It can be cleared at any time using the Clear Cache option in the extension popup, or by uninstalling the extension.",
        },
        {
            title: "Data Retention",
            content:
                "Account data including your email and Google identifier is retained for as long as your account is active.\n\nDaily usage records are retained indefinitely in aggregate for abuse detection purposes, but individual daily rows contain no information beyond a count and a date.\n\nIf you request account deletion, all data associated with your account will be permanently removed from our database within 30 days of the request.",
        },
        {
            title: "Your Rights",
            content:
                "Under applicable Indian law, including the Digital Personal Data Protection Act, 2023, you have the right to:\n\n- Access the personal data we hold about you\n- Request correction of inaccurate data\n- Request deletion of your account and associated data\n- Withdraw consent for data processing, which will result in termination of your access to the extension\n\nTo exercise any of these rights, please contact us using the details on whitepapper.antk.in. We will respond within a reasonable timeframe.",
        },
        {
            title: "Data Security",
            content:
                "We take reasonable technical measures to protect your data, including encrypted connections (HTTPS) for all communication between the extension and our backend, and secure credential storage for API keys and database access.\n\nHowever, no system is completely secure. We cannot guarantee absolute security and are not liable for unauthorized access resulting from circumstances beyond our reasonable control.",
        },
        {
            title: "Children's Privacy",
            content:
                "This extension is not intended for use by individuals under the age of 13. We do not knowingly collect personal data from children. If we become aware that a child under 13 has created an account, we will delete that account and its associated data promptly.",
        },
        {
            title: "Changes to This Policy",
            content:
                "We may update this Privacy Policy from time to time. The effective date at the top of this page will reflect the most recent revision. Continued use of the extension after changes are posted constitutes your acceptance of the updated policy.\n\nFor significant changes affecting how your data is used, we will make reasonable efforts to notify you through the extension interface.",
        },
        {
            title: "Contact",
            content:
                "For privacy-related questions, data access requests, or deletion requests, please reach out via the contact information listed on whitepapper.antk.in.",
        },
    ],
};
---

<AppLayout title="Privacy Policy">
    <LegalDocument
        title={privacyPolicyProps.title}
        summary={privacyPolicyProps.summary}
        effectiveDate={privacyPolicyProps.effectiveDate}
        sections={privacyPolicyProps.sections}
    />
</AppLayout>
